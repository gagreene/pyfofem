.python-version

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# pytest
.pytest_cache/
.coverage
htmlcov/

# massman_fof_dll_probe.py's own disposable build scratch area (rooted
# under the repo per the Phase 6 authorized filesystem boundary, never
# the system/user temp directory)
/tests/cpp_parity_live/.massman_probe_scratch/

# Phase 7's own disposable scratch area (tests/cpp_parity_live/_scratch.py),
# rooted under the repo per the Phase 7 correction pass's authorized
# filesystem boundary - golden generation, --verify-only, generator-driver
# tests, golden-tracking tests, and the gen_burnup_in_file/fire-bounds/
# Git-environment-independence tests all use this instead of the system/
# user temp directory or pytest's built-in tmp_path.
/tests/.phase7_scratch/

